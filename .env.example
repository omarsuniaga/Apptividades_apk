# SUPABASE_PUBLISHABLE_KEY: Publishable (anon) key for the Supabase project Apptividades_Lab.
# Configure this via the Secrets panel in AI Studio.
# Never put a service_role or secret key here.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# GROQ_API_KEY: Optional default Groq API key (users can also enter their own encrypted key in Settings).
GROQ_API_KEY=YOUR_GROQ_API_KEY
