<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Only the adb shell (and the system) hold DUMP, so other apps cannot trigger it. -->
        <receiver
            android:name="com.example.debug.TestAlarmSchedulerReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name="com.example.debug.TestAlarmFireReceiver"
            android:exported="false" />
    </application>
</manifest>
